# Copy to ".env". Generate a secret:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
COOKIE_SECURE=0
# Optional suggestion APIs (built-in guidance is used without them)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest
YOUTUBE_API_KEY=
LULLABY_LANGUAGE=

# --- Auth: email OTP (three-step login). Without SMTP_HOST the code is printed to the server log (dev only). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# OTP tuning (optional)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=30
OTP_MAX_RESENDS=5
LOCKOUT_THRESHOLD=8
LOCKOUT_SECONDS=900
# set to 1 ONLY in dev/testing to return the OTP in the API response instead of emailing it
OTP_DEV_ECHO=0

# --- Optional multi-baby cry separation (experimental; source model is pretrained on speech mixtures) ---
# Install: pip install -r backend/requirements-multibaby.txt
MULTI_BABY_ENABLED=0
# Optional local cache directory for pretrained separator weights
# MULTI_BABY_MODEL_DIR=backend/storage/sepformer-whamr16k

# Optional: set this to a real inbox if you want the seeded admin OTP delivered there.
# The default admin login email remains admin@auracry.local when this is not configured.
ADMIN_EMAIL=
