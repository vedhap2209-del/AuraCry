# secrets and local state - never commit these
backend/.env
*.db
backend/storage/uploads/*
backend/storage/spectrograms/*
!backend/storage/uploads/.gitkeep
!backend/storage/spectrograms/.gitkeep
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.DS_Store
# deep-model training log (large); the model file itself (cry_model.pt, ~2 MB) IS committed
backend/model/deep_train.log
mobile/android/
mobile/ios/
# unified audio dataset (rebuild with backend/data_pipeline/build_dataset.py)
data/audio/
data/sources/

# private demo credentials (generated by manage.py seed-demo)
DEMO_CREDENTIALS.md
# Capacitor / Android build artifacts (reproducible: npm install && npx cap add android)
mobile/node_modules/
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/capacitor-cordova-android-plugins/build/
mobile/android/local.properties
mobile/android/.idea/
*.apk

# optional pretrained source-separation model cache (downloaded locally)
backend/storage/sepformer-whamr16k/
